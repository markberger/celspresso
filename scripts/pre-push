#!/usr/bin/env bash
# Git pre-push hook: run the fast gate on exactly the commit being pushed.
# Install once with: ln -sf ../../scripts/pre-push .git/hooks/pre-push
#
# The gate runs on the working tree, so the tree must *be* the pushed commit: it refuses
# when there are uncommitted or untracked files, or when the pushed commit isn't HEAD.
# (It deliberately doesn't stash: edits made during a minutes-long gate would be lost.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a remote branch: nothing to test
  pushing=1
  if [[ "$local_sha" != "$head" ]]; then
    echo "pre-push: refusing to push $local_sha: it isn't HEAD ($head), so the gate can't test it." >&2
    echo "          Check it out and push again, or skip with --no-verify." >&2
    exit 1
  fi
done
[[ $pushing == 0 ]] && exit 0

if [[ -n "$(git status --porcelain)" ]]; then
  echo "pre-push: the working tree has uncommitted or untracked files, so the gate wouldn't" >&2
  echo "          test what you're pushing. Commit or stash them, or skip with --no-verify:" >&2
  git status --short >&2
  exit 1
fi

exec scripts/check.sh --fast
